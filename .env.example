# Copia este fichero a .env.local (NO se commitea) y rellena los valores.
# Frontend (públicas por diseño; la seguridad la da RLS):
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=clave "anon public" del proyecto

# SOLO backend / despliegue (SECRETA: nunca en el repo, nunca en el navegador, nunca en config.js).
# La pone Alex en el hosting. La app del navegador NO la usa: hace falta solo en el servidor propio
# que deba saltarse RLS. La usa SOLO el superadmin de Solers (api/*.js, en el servidor) para dar de alta clientes y cambiar contraseñas.
SUPABASE_SERVICE_ROLE_KEY=

# Superadmin de Solers (puerta /solers y panel maestro). SECRETO, solo en el hosting (Vercel), nunca en el repo.
# SOLERS_LLAVE_SECRETO es el MISMO que usan el Centro, Brasa y GestorOS. Sin él, /solers no existe.
# (El superadmin SÍ usa SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY en tiempo de ejecución.)
SOLERS_LLAVE_SECRETO=

# Opcionales: datos de quien ofrece Brigada (Términos y privacidad)
LEGAL_RAZON=
LEGAL_NIF=
LEGAL_DIRECCION=
LEGAL_EMAIL=
