{
  "buildCommand": "node scripts/gen-config.js",
  "outputDirectory": ".",
  "rewrites": [ { "source": "/solers", "destination": "/api/solers" } ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "private, no-store" } ] },
    { "source": "/config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
